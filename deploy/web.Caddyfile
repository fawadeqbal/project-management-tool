# Serves the built SPA inside the hearth-web container. TLS and /api routing live in the
# edge proxy in front of it (see deploy/edge.Caddyfile).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
