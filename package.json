{
  "name": "hearth",
  "private": true,
  "description": "Hearth — keyboard-first work management for teams of 5–500. Monorepo: NestJS API, React web app, shared domain, contracts and UI kit.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@hearth/api --filter=@hearth/web --filter=@hearth/domain --filter=@hearth/contracts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @hearth/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @hearth/api prisma:migrate",
    "db:seed": "pnpm --filter @hearth/api prisma:seed",
    "db:reset": "pnpm --filter @hearth/api prisma:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
